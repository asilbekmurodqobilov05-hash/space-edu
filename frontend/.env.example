# ─── Local development ────────────��──────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws

# ─── Production (set these in Vercel Dashboard → Settings → Environment Variables)
# VITE_API_URL=https://your-app.railway.app/api/v1
# VITE_WS_URL=wss://your-app.railway.app/ws

# The Gemini key lives on the backend only (apps/ai). Never put it in a
# VITE_* variable: Vite inlines those into the public bundle.