SECRET_KEY=generate_via_python_-c_"import_secrets;print(secrets.token_urlsafe(50))"
DEBUG=False
DJANGO_ENV=production
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com
# Defaults to CORS_ALLOWED_ORIGINS, plus the Railway hostname when deployed.
# Set it only if the admin at /admin/ is reached on some other domain.
CSRF_TRUSTED_ORIGINS=
# Opt-in, and think before you do: ^https://.*\.vercel\.app$ covers your preview
# deployments and also every other page anyone hosts on Vercel.
CORS_ALLOWED_ORIGIN_REGEXES=
DB_URL=postgres://user:password@localhost:5432/spaceedu
TIME_ZONE=Asia/Tashkent

# Cloudflare R2 (leave blank to use local media storage)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_CUSTOM_DOMAIN=

# Private messaging between users, most of whom are minors. Off unless someone
# has reviewed the feature against the duty of care it implies — see ticket B1
# and docs/HANDOVER.md. The moderation floor (screening, reporting, blocking,
# moderator deletion, rate limits, a consent step) is in place either way.
DM_ENABLED=false

# ── Production admin bootstrap ────────────────────────────────────────────────
# Railway has no console on a running service, so `manage.py createsuperuser`
# cannot be typed anywhere. `ensure_superuser` runs on every boot from the start
# command and reads these. Leave them unset and it does nothing.
#
# The password goes through AUTH_PASSWORD_VALIDATORS, unlike createsuperuser
# --noinput. An existing account keeps whatever password it has: re-setting one
# takes `manage.py ensure_superuser --update-password` by hand.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
